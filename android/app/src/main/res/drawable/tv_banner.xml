<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder Android TV / Google TV launcher banner (320x180dp required
     size). Swap for a proper branded banner asset later; this just keeps
     the app installable and visible on TV launchers in the meantime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#3D7FFF"/>
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher"/>
</layer-list>
